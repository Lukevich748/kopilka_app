SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Логин и bcrypt-хеш пароля для входа в приложение — сгенерировать так:
# node -e "console.log(require('bcryptjs').hashSync('ваш-пароль', 10))"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Любая случайная длинная строка — секрет для подписи сессионной куки.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
